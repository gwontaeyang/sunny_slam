Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 100
      Cell Size: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Front JT128 Timed Points
      Enabled: true
      Topic:
        Value: /slam_3d/input/hesai_front/points_timed
      Size (m): 0.02
      Style: Points
      Color Transformer: Intensity
      Queue Size: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Rear JT128 Timed Points
      Enabled: true
      Topic:
        Value: /slam_3d/input/hesai_rear/points_timed
      Size (m): 0.02
      Style: Points
      Color Transformer: Intensity
      Queue Size: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Center XT32 Timed Points
      Enabled: true
      Topic:
        Value: /slam_3d/input/hesai_center/points_timed
      Size (m): 0.02
      Style: Points
      Color Transformer: Intensity
      Queue Size: 5
    - Class: rviz_default_plugins/Odometry
      Name: Wheel IMU Reference
      Enabled: true
      Topic:
        Value: /slam_3d/reference/wheel_imu_odom
      Shape: Arrow
      Keep: 100
    - Class: rviz_default_plugins/Odometry
      Name: Frontend LIO Odometry
      Enabled: true
      Topic:
        Value: /slam_3d/frontend/odom
      Shape: Arrow
      Keep: 200
    - Class: rviz_default_plugins/Path
      Name: Frontend Path
      Enabled: true
      Topic:
        Value: /slam_3d/frontend/path
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Odometry
      Name: Backend Optimized Odometry
      Enabled: true
      Topic:
        Value: /slam_3d/backend/odom
      Shape: Arrow
      Keep: 200
    - Class: rviz_default_plugins/Path
      Name: Backend Path
      Enabled: true
      Topic:
        Value: /slam_3d/backend/path
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/PointCloud2
      Name: Active Submap
      Enabled: true
      Topic:
        Value: /slam_3d/map/active_submap
      Size (m): 0.025
      Style: Points
      Color Transformer: AxisColor
      Queue Size: 2
    - Class: rviz_default_plugins/PointCloud2
      Name: Global Map Cloud
      Enabled: false
      Topic:
        Value: /slam_3d/map/global_cloud
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
      Queue Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain Semantic Evidence
      Enabled: false
      Topic:
        Value: /slam_3d/terrain/evidence_colored
      Size (m): 0.08
      Style: Points
      Color Transformer: RGB8
      Queue Size: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Terrain Support Confidence
      Enabled: true
      Topic:
        Value: /slam_3d/terrain/support_evidence
      Size (m): 0.08
      Style: Points
      Color Transformer: RGB8
      Queue Size: 1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Target Frame: base_link
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
